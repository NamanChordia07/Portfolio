# Copy to .env (never commit .env) or export these in your shell / CI secret store.
# Only needed for `proofline generate` and `proofline eval-llm`; verification never calls a model.

# Google Gemini (pip install -e ".[gemini]"): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (GOOGLE_API_KEY is accepted as a fallback name.)

# Anthropic Claude (pip install -e ".[claude]"): https://console.anthropic.com/
ANTHROPIC_API_KEY=
